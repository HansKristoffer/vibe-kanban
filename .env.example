# =============================================================================
# Vibe Kanban Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The install-macos-service.sh script reads from .env automatically.
# =============================================================================

# -----------------------------------------------------------------------------
# Required Variables
# -----------------------------------------------------------------------------

# Public URL where the service is accessible (used for OAuth callbacks, etc.)
# Examples:
#   - Local: http://localhost:3000
#   - Tailscale Funnel: https://your-machine.tail1234.ts.net
#   - ngrok: https://abc123.ngrok.io
VK_PUBLIC_BASE_URL=

# Anthropic API key for AI features (get from https://console.anthropic.com)
VK_ANTHROPIC_API_KEY=

# Google OAuth credentials (get from Google Cloud Console)
# Required for Google Sign-In authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional Variables
# -----------------------------------------------------------------------------

# Server port (default: 3000)
# PORT=3000

# Server host/bind address
# Default: 0.0.0.0 (all interfaces)
# When TAILSCALE_FUNNEL=1, defaults to 127.0.0.1 (localhost only)
# HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Tailscale Funnel (Optional)
# -----------------------------------------------------------------------------
# Enable Tailscale Funnel for public HTTPS access without port forwarding
# Requires: Tailscale installed, logged in, and Funnel enabled in admin console
# Set to 1, true, or yes to enable
# TAILSCALE_FUNNEL=1
